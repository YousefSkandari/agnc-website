# Supabase (the "agnc" project): Project Settings > API. The secret key stays on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (resend.com) for the confirmation email, the calendar invite and your heads-up email.
# Optional: without it, requests are still saved, just no emails go out.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend
EMAIL_FROM=agnc. media <hello@yourdomain.com>
# Where new requests are sent; comma-separate for both of you
NOTIFY_EMAIL=

# Optional: the site's own address for link previews. On Vercel the production domain is used when this is empty.
NEXT_PUBLIC_SITE_URL=
